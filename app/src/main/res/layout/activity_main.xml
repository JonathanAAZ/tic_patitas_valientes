<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewCrearCuenta"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_huellas_amarillo"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- Zona de marca sobre el amarillo -->
    <LinearLayout
        android:id="@+id/lLMarcaPrincipal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/ivLogoAgrupacion"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/logo_patitas_valientes"
            android:contentDescription="Logo de Patitas Valientes" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Patitas Valientes"
            android:textAlignment="center"
            android:textColor="@color/lila"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tVLemaPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cada huella merece un hogar"
            android:textAlignment="center"
            android:textColor="@color/lila"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Hoja inferior con las acciones, igual que el resto de pantallas -->
    <LinearLayout
        android:id="@+id/lLAccionesPrincipal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bordes_fragment"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Bienvenido"
            android:textAlignment="center"
            android:textColor="@color/lila"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Acción principal -->
        <LinearLayout
            android:id="@+id/btnIrIS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/border"
            android:backgroundTint="@color/lila"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/baseline_person_24"
                android:backgroundTint="@color/white"
                android:contentDescription="Iniciar sesión" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Iniciar sesión"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Acción secundaria -->
        <LinearLayout
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/border"
            android:backgroundTint="@color/blue_2"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/ic_agregar_usuario"
                android:backgroundTint="@color/white"
                android:contentDescription="Registrarse" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Registrarse"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
