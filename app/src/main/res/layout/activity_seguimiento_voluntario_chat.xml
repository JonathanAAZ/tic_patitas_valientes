<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yellow"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:focusableInTouchMode="true"
    tools:context=".Vista.SeguimientoVoluntarioChatActivity">

    <!-- Encabezado -->
    <RelativeLayout
        android:id="@+id/lYSuperiorSeguimientoVoluntarioChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/yellow">

        <ImageView
            android:id="@+id/iVRegresarSeguimientoVoluntarioChat"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:background="@drawable/ic_retroceder"
            android:backgroundTint="@color/lila"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tVTituloSeguimientoVoluntarioChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Chat de seguimiento"
            android:textAlignment="center"
            android:textColor="@color/lila"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/viewTituloVerMascotas"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/tVTituloSeguimientoVoluntarioChat"
            android:layout_marginTop="20dp"
            android:background="@color/yellow" />
    </RelativeLayout>

    <!-- Sección de mensajes -->
    <LinearLayout
        android:id="@+id/lLChatSeguimientoVoluntario"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/lYSuperiorSeguimientoVoluntarioChat"
        android:background="@drawable/bordes_fragment"
        android:orientation="vertical">

        <!-- RecyclerView para mostrar mensajes -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewChatSeguiVol"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp" />

        <!-- Sección de escritura y acciones -->
        <LinearLayout
            android:id="@+id/lLOpcionesMensajeria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Campo para escribir mensajes -->
            <EditText
                android:id="@+id/eTEscribirMensaje"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:drawable/editbox_background"
                android:hint="Escriba un mensaje"
                android:padding="8dp"
                android:textSize="16sp" />

            <!-- Botón para adjuntar archivos -->
            <ImageView
                android:id="@+id/iVAdjuntarArchivo"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_margin="2dp"
                android:background="@drawable/ic_clip"
                android:backgroundTint="@color/blue_2"
                android:clickable="true"
                android:focusable="true" />

            <!-- Botón para enviar mensajes -->
            <LinearLayout
                android:id="@+id/lLEnviarMensaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@drawable/border"
                android:backgroundTint="@color/blue_2"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="5dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:backgroundTint="@color/white"
                    android:src="@drawable/ic_enviar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Enviar"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- CardView oculto con las opciones en un Grid -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardOpcionesAdjuntar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:backgroundTint="@color/blue_word"
        android:padding="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="60dp"
        android:visibility="gone">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:padding="8dp"
            android:rowCount="2">

            <!-- Opción: Subir video -->
            <LinearLayout
                android:id="@+id/lLOpcionSubirVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:contentDescription="Subir Video"
                    android:backgroundTint="@color/white"
                    android:background="@drawable/ic_galeria" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Subir Video"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Opción: Subir foto -->
            <LinearLayout
                android:id="@+id/lLOpcionSubirFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/white"
                    android:background="@drawable/ic_galeria" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Subir Foto"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Opción: Grabar video -->
            <LinearLayout
                android:id="@+id/lLOpcionGrabarVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/white"
                    android:background="@drawable/ic_video" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Grabar Video"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Opción: Tomar foto -->
            <LinearLayout
                android:id="@+id/lLOpcionTomarFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/white"
                    android:background="@drawable/ic_camara" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Tomar Foto"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </GridLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>