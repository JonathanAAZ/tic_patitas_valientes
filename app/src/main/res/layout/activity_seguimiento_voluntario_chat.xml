<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yellow"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:focusableInTouchMode="true"
    tools:context=".Vista.SeguimientoVoluntarioChatActivity">

    <!-- Encabezado -->
    <RelativeLayout
        android:id="@+id/lYSuperiorSeguimientoVoluntarioChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/yellow">

        <!-- Fila del titulo: se aisla para que el centrado vertical no arrastre
             el titulo ni el boton Retirar hacia la barra del plan -->
        <RelativeLayout
            android:id="@+id/rLTituloSeguimientoVoluntarioChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/iVRegresarSeguimientoVoluntarioChat"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="5dp"
                android:background="@drawable/ic_retroceder"
                android:backgroundTint="@color/lila"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/tVTituloSeguimientoVoluntarioChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/iVRegresarSeguimientoVoluntarioChat"
                android:layout_toStartOf="@+id/lLRetirarMascota"
                android:text="Chat de seguimiento"
                android:textAlignment="center"
                android:textColor="@color/lila"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Acción destructiva: va en el encabezado para no competir con Enviar -->
            <LinearLayout
                android:id="@+id/lLRetirarMascota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:background="@drawable/border"
                android:backgroundTint="@color/red"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/ic_eliminar"
                    android:backgroundTint="@color/white"
                    android:contentDescription="Retirar mascota" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Retirar"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Estado del plan de recordatorios y acceso a gestionarlo -->
        <LinearLayout
            android:id="@+id/lLPlanSeguimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rLTituloSeguimientoVoluntarioChat"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/border"
            android:backgroundTint="@color/celeste"
            android:backgroundTintMode="multiply"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/tVPlanSeguimiento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cargando el plan de seguimiento..."
                android:textColor="@color/black"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/lLGestionarPlanSeguimiento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/border"
                android:backgroundTint="@color/blue_2"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/ic_seguimiento"
                    android:backgroundTint="@color/white"
                    android:contentDescription="Gestionar el plan de seguimiento" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Gestionar"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/viewTituloVerMascotas"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/lLPlanSeguimiento"
            android:layout_marginTop="20dp"
            android:background="@color/yellow" />
    </RelativeLayout>

    <!-- Sección de mensajes -->
    <LinearLayout
        android:id="@+id/lLChatSeguimientoVoluntario"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/lYSuperiorSeguimientoVoluntarioChat"
        android:background="@drawable/bordes_fragment"
        android:orientation="vertical">

        <!-- RecyclerView para mostrar mensajes -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewChatSeguiVol"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp" />

        <!-- Sección de escritura y acciones -->
        <LinearLayout
            android:id="@+id/lLOpcionesMensajeria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Botón para mostrar preguntas frecuentes -->
            <LinearLayout
                android:id="@+id/lLMostrarPreguntasFrecuentes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/border"
                android:backgroundTint="@color/blue_2"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/ic_visto_bueno"
                    android:backgroundTint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Preguntas Frecuentes"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/iVFlechaPreguntasFrecuentes"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/ic_flecha_abajo"
                    android:backgroundTint="@color/white" />
            </LinearLayout>

            <!-- Vista previa del mensaje al que se responde, oculta si no aplica -->
            <LinearLayout
                android:id="@+id/lLRespondiendoMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/border"
                android:backgroundTint="@color/celeste"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue_2" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/tVRespondiendoEmisor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/lila"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tVRespondiendoContenido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/lila"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iVCancelarRespuesta"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/ic_cerrar"
                    android:backgroundTint="@color/lila"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <!-- Fila de EditText y botones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Campo para escribir mensajes -->
                <EditText
                    android:id="@+id/eTEscribirMensaje"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:drawable/editbox_background"
                    android:hint="Escriba un mensaje"
                    android:padding="8dp"
                    android:textSize="16sp" />

                <!-- Botón para adjuntar archivos -->
                <ImageView
                    android:id="@+id/iVAdjuntarArchivo"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/ic_clip"
                    android:backgroundTint="@color/blue_2"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Botón para enviar mensajes -->
                <LinearLayout
                    android:id="@+id/lLEnviarMensaje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:background="@drawable/border"
                    android:backgroundTint="@color/blue_2"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal"
                    android:padding="5dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:backgroundTint="@color/white"
                        android:src="@drawable/ic_enviar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Enviar"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <!-- Reemplaza a la barra de escritura cuando el seguimiento ya esta cerrado -->
        <LinearLayout
            android:id="@+id/lLSeguimientoCerrado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/border"
            android:backgroundTint="@color/gray"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tVSeguimientoCerrado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Este seguimiento está cerrado. Ya no puede enviar mensajes."
                android:textColor="@color/lila"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- CardView con Preguntas Frecuentes (oculto por defecto) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPreguntasFrecuentes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/lLChatSeguimientoVoluntario"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="125dp"
        android:backgroundTint="@color/white"
        android:elevation="4dp"
        android:visibility="gone"
        app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seleccione una pregunta:"
                android:textColor="@color/lila"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <!-- ScrollView para preguntas frecuentes -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="200dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Pregunta 1 -->
                    <TextView
                        android:id="@+id/tVPregunta1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp"
                        android:text="¿La mascota llora?"
                        android:textColor="@color/blue_2"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <!-- Pregunta 2 -->
                    <TextView
                        android:id="@+id/tVPregunta2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp"
                        android:text="¿La mascota se alimenta de forma normal?"
                        android:textColor="@color/blue_2"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <!-- Pregunta 3 -->
                    <TextView
                        android:id="@+id/tVPregunta3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp"
                        android:text="¿Necesita algún tipo de cuidado especial?"
                        android:textColor="@color/blue_2"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <!-- Pregunta 4 -->
                    <TextView
                        android:id="@+id/tVPregunta4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp"
                        android:text="¿Cuál es el estado de ánimo de la mascota? (Feliz, Ansiosa, Tranquila, Triste)"
                        android:textColor="@color/blue_2"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <!-- Pregunta 5 -->
                    <TextView
                        android:id="@+id/tVPregunta5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp"
                        android:text="¿Cómo ha sido la interacción de la mascota con los miembros de la familia?"
                        android:textColor="@color/blue_2"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <!-- Pregunta 6 -->
                    <TextView
                        android:id="@+id/tVPregunta6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp"
                        android:text="¿Ha notado algún comportamiento inusual?"
                        android:textColor="@color/blue_2"
                        android:textSize="14sp" />

                    <!-- Pregunta 7 -->
                    <TextView
                        android:id="@+id/tVPregunta7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp"
                        android:text="¿Se han presentado problemas desde la adopción?"
                        android:textColor="@color/blue_2"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <!-- Pregunta 8 -->
                    <TextView
                        android:id="@+id/tVPregunta8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp"
                        android:text="¿Cómo se ha adoptado la mascota a su nuevo hogar?"
                        android:textColor="@color/blue_2"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <!-- Pregunta 9 -->
                    <TextView
                        android:id="@+id/tVPregunta9"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp"
                        android:text="¿Ha llevado a la mascota al veterinario?"
                        android:textColor="@color/blue_2"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <!-- Pregunta 10 -->
                    <TextView
                        android:id="@+id/tVPregunta10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp"
                        android:text="¿La mascota está al día con sus vacunas y desparasitaciones?"
                        android:textColor="@color/blue_2"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <!-- Pregunta 11 -->
                    <TextView
                        android:id="@+id/tVPregunta11"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp"
                        android:text="¿Qué tipo de alimentación recibe la mascota?"
                        android:textColor="@color/blue_2"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <!-- Pregunta 12 -->
                    <TextView
                        android:id="@+id/tVPregunta12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp"
                        android:text="¿Cuánto ejercicio o tiempo de juego se dedica al día?"
                        android:textColor="@color/blue_2"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <!-- Pregunta 13 -->
                    <TextView
                        android:id="@+id/tVPregunta13"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp"
                        android:text="¿Existe alguna inquietud sobre el cuidado de la mascota?"
                        android:textColor="@color/blue_2"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <!-- Pregunta 14 -->
                    <TextView
                        android:id="@+id/tVPregunta14"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp"
                        android:text="¿Se siente conforme con la adopción de su mascota?"
                        android:textColor="@color/blue_2"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- CardView oculto con las opciones de adjuntar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardOpcionesAdjuntar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_gravity="end"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="150dp"
        android:backgroundTint="@color/blue_word"
        android:padding="10dp"
        android:visibility="gone"
        app:cardCornerRadius="8dp"
        android:elevation="4dp">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:padding="8dp"
            android:rowCount="2">

            <!-- Opción: Subir video -->
            <LinearLayout
                android:id="@+id/lLOpcionSubirVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/ic_galeria"
                    android:backgroundTint="@color/white"
                    android:contentDescription="Subir Video" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Subir Video"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Opción: Subir foto -->
            <LinearLayout
                android:id="@+id/lLOpcionSubirFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/ic_galeria"
                    android:backgroundTint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Subir Foto"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Opción: Grabar video -->
            <LinearLayout
                android:id="@+id/lLOpcionGrabarVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/ic_video"
                    android:backgroundTint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Grabar Video"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Opción: Tomar foto -->
            <LinearLayout
                android:id="@+id/lLOpcionTomarFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/ic_camara"
                    android:backgroundTint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Tomar Foto"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </GridLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
